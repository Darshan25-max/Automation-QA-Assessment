{
  "id": "uptimeMon001",
  "name": "Website Uptime Monitor",
  "nodes": [
    {
      "id": "b1",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "b2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "site_url",
              "value": "https://demo.realworld.io/",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "telegram_chat_id",
              "value": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "b3",
      "name": "Check Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.site_url }}",
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b4",
      "name": "Status is not 200?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b5",
      "name": "Format Alert (bad status)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "message",
              "type": "string",
              "value": "=🚨 Site check FAILED\nURL: {{ String($('Config').first().json.site_url).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}\nHTTP status: {{ $json.statusCode }}\nTime: {{ $now.toISO() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "b6",
      "name": "Format Alert (no response)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        400
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "message",
              "type": "string",
              "value": "=🚨 Site UNREACHABLE (no HTTP response)\nURL: {{ String($('Config').first().json.site_url).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}\nReason: {{ String($json.error && $json.error.message ? $json.error.message : 'unknown').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}\nTime: {{ $now.toISO() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "b7",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "chatId": "={{ $('Config').first().json.telegram_chat_id }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram Bot"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b8",
      "name": "Site OK (no alert)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        200
      ],
      "parameters": {}
    },
    {
      "id": "b9",
      "name": "Log Error (fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fallback logging when the Telegram alert itself fails.\nconst staticData = $getWorkflowStaticData('global');\nstaticData.errorLog = staticData.errorLog || [];\nconst entries = $input.all().map(i => ({\n  time: new Date().toISOString(),\n  workflow: $workflow.name,\n  executionId: $execution.id,\n  error: (i.json && (i.json.error || i.json.message)) || i.json || 'unknown error',\n}));\nentries.forEach(e => console.error('[WORKFLOW ERROR]', JSON.stringify(e)));\nstaticData.errorLog.push(...entries);\nstaticData.errorLog = staticData.errorLog.slice(-50);\nreturn entries.map(e => ({ json: e }));\n"
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Check Website",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Website": {
      "main": [
        [
          {
            "node": "Status is not 200?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Alert (no response)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Status is not 200?": {
      "main": [
        [
          {
            "node": "Format Alert (bad status)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Site OK (no alert)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert (bad status)": {
      "main": [
        [
          {
            "node": "Send Telegram Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert (no response)": {
      "main": [
        [
          {
            "node": "Send Telegram Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram Alert": {
      "main": [
        [],
        [
          {
            "node": "Log Error (fallback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}