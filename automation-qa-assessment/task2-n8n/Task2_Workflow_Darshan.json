{
  "id": "repoMonitor01",
  "name": "GitHub Repository Monitor",
  "nodes": [
    {
      "id": "n1",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "telegram_chat_id",
              "value": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "min_stars",
              "value": 1000,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Fetch Popular Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/search/repositories",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "stars:>1000"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-repo-monitor"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "githubApi": {
          "id": "REPLACE_ME",
          "name": "GitHub account (token)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "n4",
      "name": "Filter & Pick Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Input: one item whose json.items is the array returned by GitHub search.\nconst repos = $input.first().json.items;\n\nif (!Array.isArray(repos)) {\n  throw new Error('Unexpected GitHub response: \"items\" is not an array');\n}\n\nconst top5 = repos\n  .filter(r => r && !r.archived && !r.disabled && r.owner && r.owner.login) // drop unusable repos\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)                   // most stars first\n  .slice(0, 5);                                                              // keep top 5\n\nif (top5.length === 0) {\n  throw new Error('No repositories left after filtering');\n}\n\n// One output item per repo -> the next HTTP node runs once per repo.\nreturn top5.map(r => ({ json: { owner: r.owner.login, name: r.name, full_name: r.full_name } }));\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "n5",
      "name": "Fetch Repo Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.name }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-repo-monitor"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "githubApi": {
          "id": "REPLACE_ME",
          "name": "GitHub account (token)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "n6",
      "name": "Stars > 1000?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.stargazers_count }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n7",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "chatId": "={{ $('Config').first().json.telegram_chat_id }}",
        "text": "=⭐ Popular repo: {{ String($json.full_name).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}\nStars: {{ $json.stargazers_count }}\nForks: {{ $json.forks_count }}\nLanguage: {{ String($json.language || 'n/a').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}\nDescription: {{ String($json.description || 'n/a').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}\n{{ $json.html_url }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram Bot"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "n8",
      "name": "Skip (not enough stars)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        200
      ],
      "parameters": {}
    },
    {
      "id": "n9",
      "name": "Log Error (fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fallback logging: every failing node routes here via its error output.\n// Entries go to the execution output, console, and a rolling log in workflow static data.\nconst staticData = $getWorkflowStaticData('global');\nstaticData.errorLog = staticData.errorLog || [];\n\nconst entries = $input.all().map(item => ({\n  time: new Date().toISOString(),\n  workflow: $workflow.name,\n  executionId: $execution.id,\n  error: (item.json && (item.json.error || item.json.message)) || item.json || 'unknown error',\n}));\n\nentries.forEach(e => console.error('[WORKFLOW ERROR]', JSON.stringify(e)));\nstaticData.errorLog.push(...entries);\nstaticData.errorLog = staticData.errorLog.slice(-50); // keep last 50 only\n\nreturn entries.map(e => ({ json: e }));\n"
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch Popular Repos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Popular Repos": {
      "main": [
        [
          {
            "node": "Filter & Pick Top 5",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error (fallback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter & Pick Top 5": {
      "main": [
        [
          {
            "node": "Fetch Repo Details",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error (fallback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Repo Details": {
      "main": [
        [
          {
            "node": "Stars > 1000?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error (fallback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stars > 1000?": {
      "main": [
        [
          {
            "node": "Send Telegram Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip (not enough stars)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram Alert": {
      "main": [
        [],
        [
          {
            "node": "Log Error (fallback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}